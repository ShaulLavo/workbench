{
  "name": "@shaulavo/workbench",
  "version": "0.1.19",
  "description": "Shared MIT React 19 workbench UI library (tokens, core adapters, icons, UI shell, virtualized file tree, Ghostty terminal, live preview, and Singapore editor)",
  "license": "MIT",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/index.js",
    "./dist/icons/index.js",
    "./dist/tree/index.js",
    "./dist/terminal/index.js",
    "./dist/preview/index.js",
    "./dist/editor/index.js",
    "./dist/editor/groups/index.js",
    "./dist/editor/lsp/index.js",
    "./dist/editor/composer/index.js",
    "./dist/editor/diff/index.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js",
      "default": "./dist/tokens/index.js"
    },
    "./icons/core": {
      "types": "./dist/icons/core.d.ts",
      "import": "./dist/icons/core.js",
      "default": "./dist/icons/core.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js",
      "default": "./dist/icons/index.js"
    },
    "./tree/model": {
      "types": "./dist/tree/model.d.ts",
      "import": "./dist/tree/model.js",
      "default": "./dist/tree/model.js"
    },
    "./tree": {
      "types": "./dist/tree/index.d.ts",
      "import": "./dist/tree/index.js",
      "default": "./dist/tree/index.js"
    },
    "./terminal": {
      "types": "./dist/terminal/index.d.ts",
      "import": "./dist/terminal/index.js",
      "default": "./dist/terminal/index.js"
    },
    "./preview": {
      "types": "./dist/preview/index.d.ts",
      "import": "./dist/preview/index.js",
      "default": "./dist/preview/index.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/editor/index.js",
      "default": "./dist/editor/index.js"
    },
    "./editor/groups": {
      "types": "./dist/editor/groups/index.d.ts",
      "import": "./dist/editor/groups/index.js",
      "default": "./dist/editor/groups/index.js"
    },
    "./editor/lsp": {
      "types": "./dist/editor/lsp/index.d.ts",
      "import": "./dist/editor/lsp/index.js",
      "default": "./dist/editor/lsp/index.js"
    },
    "./editor/composer": {
      "types": "./dist/editor/composer/index.d.ts",
      "import": "./dist/editor/composer/index.js",
      "default": "./dist/editor/composer/index.js"
    },
    "./editor/diff": {
      "types": "./dist/editor/diff/index.d.ts",
      "import": "./dist/editor/diff/index.js",
      "default": "./dist/editor/diff/index.js"
    },
    "./layers.css": "./dist/layers.css",
    "./reset.css": "./dist/reset.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./themes/fregat.css": "./dist/themes/fregat.css",
    "./themes/sprockt.css": "./dist/themes/sprockt.css",
    "./THIRD_PARTY_NOTICES.txt": "./THIRD_PARTY_NOTICES.txt",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "bun scripts/build-icons.ts && bunx oxfmt --write src/icons/generated/glyphs.ts",
    "build": "vite build && tsc -p tsconfig.build.json && bun scripts/postbuild.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@shaulavo/hotkeys": "catalog:"
  },
  "devDependencies": {
    "@base-ui/react": "catalog:",
    "@dnd-kit/core": "catalog:",
    "@dnd-kit/sortable": "catalog:",
    "@dnd-kit/utilities": "catalog:",
    "@iconify-json/catppuccin": "catalog:",
    "@pierre/vscode-icons": "catalog:",
    "@singapore-editor/core": "catalog:",
    "@singapore-editor/diff": "catalog:",
    "@singapore-editor/find": "catalog:",
    "@singapore-editor/gutters": "catalog:",
    "@singapore-editor/highlighting": "catalog:",
    "@singapore-editor/lsp": "catalog:",
    "@singapore-editor/lsp-plugin": "catalog:",
    "@singapore-editor/markdown": "catalog:",
    "@singapore-editor/plugin-ui": "catalog:",
    "@singapore-editor/react": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "ghostty-webgpu": "catalog:",
    "happy-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "simple-icons": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@base-ui/react": "1.9.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@singapore-editor/core": "0.2.14",
    "@singapore-editor/diff": "0.2.14",
    "@singapore-editor/find": "0.2.14",
    "@singapore-editor/gutters": "0.2.14",
    "@singapore-editor/highlighting": "0.2.17",
    "@singapore-editor/lsp": "0.2.13",
    "@singapore-editor/lsp-plugin": "0.2.17",
    "@singapore-editor/markdown": "0.2.14",
    "@singapore-editor/plugin-ui": "0.2.14",
    "@singapore-editor/react": "0.2.14",
    "ghostty-webgpu": "0.3.34",
    "react": ">=19.2.0",
    "react-dom": ">=19.2.0"
  },
  "peerDependenciesMeta": {
