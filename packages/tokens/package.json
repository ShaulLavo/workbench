{
  "name": "@shaulavo/workbench-tokens",
  "version": "0.0.1",
  "license": "MIT",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
