      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./reset.css": "./dist/reset.css",
    "./tailwind-bridge.css": "./dist/tailwind-bridge.css",
    "./themes/fregat.css": "./dist/themes/fregat.css",
    "./themes/sprockt.css": "./dist/themes/sprockt.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && bun scripts/copy-css.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "happy-dom": "^20.14.5",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
