{
  "name": "@shaulavo/workbench-editor",
  "version": "0.1.0",
  "license": "MIT",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
