  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./groups": {
      "types": "./dist/groups/index.d.ts",
      "import": "./dist/groups/index.js"
    },
    "./lsp": {
      "types": "./dist/lsp/index.d.ts",
      "import": "./dist/lsp/index.js"
    },
    "./composer": {
      "types": "./dist/composer/index.d.ts",
      "import": "./dist/composer/index.js"
    },
    "./diff": {
      "types": "./dist/diff/index.d.ts",
      "import": "./dist/diff/index.js"
    },
    "./editor.css": "./dist/editor.css"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && bun scripts/copy-assets.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@shaulavo/workbench-core": "workspace:*",
    "@shaulavo/workbench-icons": "workspace:*",
