{
  "name": "workbench-monorepo",
  "private": true,
  "license": "MIT",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*",
      "examples/*"
    ],
    "catalog": {
      "@base-ui/react": "1.9.0",
      "@dnd-kit/core": "6.3.1",
      "@dnd-kit/sortable": "10.0.0",
      "@dnd-kit/utilities": "3.2.2",
      "@iconify-json/catppuccin": "1.2.17",
      "@pierre/vscode-icons": "0.0.9",
      "@shaulavo/hotkeys": "0.0.4",
      "@singapore-editor/core": "0.2.13",
      "@singapore-editor/diff": "0.2.13",
      "@singapore-editor/find": "0.2.13",
      "@singapore-editor/gutters": "0.2.13",
      "@singapore-editor/highlighting": "0.2.16",
      "@singapore-editor/lsp": "0.2.13",
      "@singapore-editor/lsp-plugin": "0.2.16",
      "@singapore-editor/markdown": "0.2.13",
      "@singapore-editor/minimap": "0.2.13",
      "@singapore-editor/plugin-ui": "0.2.13",
      "@singapore-editor/react": "0.2.13",
      "@singapore-editor/scope-lines": "0.2.13",
      "@tanstack/react-virtual": "3.14.28",
      "ghostty-webgpu": "0.3.34",
      "@types/bun": "1.4.4",
      "@types/react": "19.3.3",
      "@types/react-dom": "19.3.0",
      "@vitejs/plugin-react": "6.3.0",
      "happy-dom": "20.14.5",
      "oxfmt": "0.70.0",
      "oxlint": "1.88.0",
      "oxc-transform-react": "0.151.0",
      "playwright": "1.64.1",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "simple-icons": "16.38.1",
      "turbo": "2.11.5",
      "typescript": "7.0.2",
      "vite": "8.3.4",
      "vitest": "5.0.2"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build --filter='@shaulavo/*'",
    "typecheck": "turbo run typecheck",
    "lint": "bun scripts/check-javascript.ts && oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "license:check": "bun scripts/license-check.ts",
    "compiler:census": "bun scripts/compiler-census.ts",
    "pack:check": "bun run build && bun scripts/pack-check.ts",
    "bench:tree": "bun scripts/bench-tree.ts",
    "bench:tree:gate": "bun scripts/bench-tree.ts --gate",
    "gates": "bun run typecheck && bun run lint && bun run format:check && bun run license:check && bun run compiler:census",
    "test:unit": "turbo run test",
    "test:browser": "bun run build && bunx playwright test --config apps/harness/e2e/playwright.config.ts",
    "verify:browser": "bun scripts/verify-browser.ts",
    "verify": "bun run build && bun run gates && bun run test:unit && bun run pack:check && bun run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "catalog:",
    "@types/node": "26.6.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "oxc-plugin-react-compiler": "0.2.0",
    "oxc-transform-react": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwindcss": "4.3.3",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.4.4"
}
